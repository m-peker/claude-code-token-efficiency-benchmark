+
+
+@pytest.mark.parametrize("via_settings", [True, False])
+def test_default_map_subcommand(runner, via_settings):
+    """A group's ``default_map`` is looked up by subcommand name."""
+    default_map = {"sub": {"port": 5000}}
+    settings = {"default_map": default_map} if via_settings else {}
+
+    @click.group(context_settings=settings)
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    @click.pass_context
+    def sub(ctx, port):
+        source = ctx.get_parameter_source("port")
+        click.echo(f"port={port} source={source.name}")
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def other(port):
+        click.echo(f"port={port}")
+
+    extra = {} if via_settings else {"default_map": default_map}
+    result = runner.invoke(cli, ["sub"], **extra)
+    assert result.exit_code == 0, result.output
+    assert result.output.strip() == "port=5000 source=DEFAULT_MAP"
+
+    result = runner.invoke(cli, ["other"], **extra)
+    assert result.exit_code == 0, result.output
+    assert result.output.strip() == "port=8000"
+
+
+def test_default_map_nested_subcommand(runner):
+    """Nested groups each descend one level into ``default_map``."""
+
+    @click.group(
+        context_settings={"default_map": {"outer": {"inner": {"port": 5000}}}}
+    )
+    def cli():
+        pass
+
+    @cli.group()
+    def outer():
+        pass
+
+    @outer.command()
+    @click.option("--port", default=8000)
+    def inner(port):
+        click.echo(f"port={port}")
+
+    result = runner.invoke(cli, ["outer", "inner"])
+    assert result.exit_code == 0, result.output
+    assert result.output.strip() == "port=5000"
+
+
+def test_default_map_chained_subcommands(runner):
+    """Chained subcommands each get their own ``default_map`` entry."""
+
+    @click.group(
+        chain=True,
+        context_settings={"default_map": {"a": {"x": 1}, "b": {"x": 2}}},
+    )
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--x", default=0)
+    def a(x):
+        click.echo(f"a={x}")
+
+    @cli.command()
+    @click.option("--x", default=0)
+    def b(x):
+        click.echo(f"b={x}")
+
+    result = runner.invoke(cli, ["a", "b"])
+    assert result.exit_code == 0, result.output
+    assert result.output.split() == ["a=1", "b=2"]
