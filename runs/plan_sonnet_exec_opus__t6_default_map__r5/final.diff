+
+
+def test_default_map_subcommand(runner):
+    """A subcommand reads its defaults from the parent's ``default_map``
+    entry matching its name, including for nested groups.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def runserver(port):
+        click.echo(f"port={port}")
+
+    @cli.group()
+    def db():
+        pass
+
+    @db.command()
+    @click.option("--name", default="default")
+    def init(name):
+        click.echo(f"name={name}")
+
+    default_map = {"runserver": {"port": 5000}, "db": {"init": {"name": "mapped"}}}
+
+    result = runner.invoke(cli, ["runserver"], default_map=default_map)
+    assert result.output.strip() == "port=5000"
+
+    result = runner.invoke(cli, ["db", "init"], default_map=default_map)
+    assert result.output.strip() == "name=mapped"
+
+    cli.context_settings = {"default_map": default_map}
+    result = runner.invoke(cli, ["runserver"])
+    assert result.output.strip() == "port=5000"
+
+    # Missing subcommand entry falls back to the option default.
+    result = runner.invoke(cli, ["runserver"], default_map={"other": {}})
+    assert result.output.strip() == "port=8000"
