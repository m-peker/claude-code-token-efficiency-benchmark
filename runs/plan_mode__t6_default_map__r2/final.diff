diff --git a/tests/test_defaults.py b/tests/test_defaults.py
index bb2684c..6da86d7 100644
--- a/tests/test_defaults.py
+++ b/tests/test_defaults.py
@@ -556,3 +556,40 @@ def test_unset_in_default_map(runner):
     result = runner.invoke(cli, [])
     assert result.exit_code == 0
     assert result.output.strip() == "port=8000"
+
+
+def test_default_map_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--opt", default="fallback")
+    def sub(opt):
+        click.echo(opt)
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"opt": "x"}})
+    assert result.output == "x\n"
+
+    result = runner.invoke(cli, ["sub"], default_map={"other": {"opt": "x"}})
+    assert result.output == "fallback\n"
+
+
+def test_default_map_nested_groups(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def mid():
+        pass
+
+    @mid.command()
+    @click.option("--opt", default="fallback")
+    def leaf(opt):
+        click.echo(opt)
+
+    result = runner.invoke(
+        cli, ["mid", "leaf"], default_map={"mid": {"leaf": {"opt": "deep"}}}
+    )
+    assert result.output == "deep\n"
