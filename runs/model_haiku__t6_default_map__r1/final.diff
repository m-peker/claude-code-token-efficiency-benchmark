diff --git a/tests/test_defaults.py b/tests/test_defaults.py
index bb2684c..e4569d9 100644
--- a/tests/test_defaults.py
+++ b/tests/test_defaults.py
@@ -556,3 +556,23 @@ def test_unset_in_default_map(runner):
     result = runner.invoke(cli, [])
     assert result.exit_code == 0
     assert result.output.strip() == "port=8000"
+
+
+def test_default_map_applies_to_subcommand(runner):
+    """A nested ``default_map`` entry keyed by subcommand name applies to
+    that subcommand's options.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def runserver(port):
+        click.echo(port)
+
+    result = runner.invoke(
+        cli, ["runserver"], default_map={"runserver": {"port": 5000}}
+    )
+    assert result.output == "5000\n"
