diff --git a/tests/test_types.py b/tests/test_types.py
index 842c426..6526652 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -328,3 +328,34 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("args", "expect"),
+    [
+        (["--set", "a=b"], ("a", "b")),
+        (["--set", "a=b=c"], ("a", "b=c")),
+        (["--set", "a="], ("a", "")),
+    ],
+)
+def test_key_value(runner, args, expect):
+    @click.command()
+    @click.option("--set", "kv", type=click.KeyValue())
+    def cli(kv):
+        click.echo(repr(kv))
+
+    result = runner.invoke(cli, args)
+    assert not result.exception
+    assert result.output.strip() == repr(expect)
+
+
+@pytest.mark.parametrize("value", ["abc", "=v", ""])
+def test_key_value_fail(runner, value):
+    @click.command()
+    @click.option("--set", "kv", type=click.KeyValue())
+    def cli(kv):
+        pass
+
+    result = runner.invoke(cli, ["--set", value])
+    assert result.exit_code == 2
+    assert "is not a valid key=value pair" in result.output
