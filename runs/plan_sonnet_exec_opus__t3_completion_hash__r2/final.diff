+@pytest.mark.parametrize(
+    ("shell", "env", "expect"),
+    [
+        ("bash", {"COMP_WORDS": "cli a#1", "COMP_CWORD": "1"}, "plain,a#1\n"),
+        ("zsh", {"COMP_WORDS": "cli a#1", "COMP_CWORD": "1"}, "plain\na#1\n_\n"),
+        ("fish", {"COMP_WORDS": "cli a#1", "COMP_CWORD": "a#1"}, "plain,a#1\n"),
+        (
+            "powershell",
+            {"COMP_WORDS": "cli a#1", "COMP_CWORD": "1"},
+            "plain\na#1\n_\n",
+        ),
+    ],
+)
+@pytest.mark.usefixtures("_patch_for_completion")
+def test_full_complete_hash(runner, shell, env, expect):
+    """A ``#`` in an argument is not treated as the start of a comment."""
+    cli = Group("cli", commands=[Command("a#1"), Command("a#2")])
+    env["_CLI_COMPLETE"] = f"{shell}_complete"
+    result = runner.invoke(cli, env=env)
+    assert result.output == expect
+
