+
+
+def test_subcommand_default_map(runner):
+    """A subcommand reads its defaults from the nested ``default_map``
+    entry matching its name, not from the parent's whole mapping.
+    """
+
+    @click.group(context_settings={"default_map": {"sub": {"opt": "from-map"}}})
+    def cli():
+        pass
+
+    @cli.command("sub")
+    @click.option("--opt", default="from-param")
+    def sub(opt):
+        click.echo(f"opt={opt}")
+
+    result = runner.invoke(cli, ["sub"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "opt=from-map"
+
+    result = runner.invoke(cli, ["sub", "--opt", "from-cli"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "opt=from-cli"
+
+
+def test_subcommand_default_map_missing_entry(runner):
+    """A subcommand without a matching ``default_map`` entry falls back
+    to its parameter default.
+    """
+
+    @click.group(context_settings={"default_map": {"other": {"opt": "x"}}})
+    def cli():
+        pass
+
+    @cli.command("sub")
+    @click.option("--opt", default="from-param")
+    def sub(opt):
+        click.echo(f"opt={opt}")
+
+    result = runner.invoke(cli, ["sub"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "opt=from-param"
+
+
+def test_nested_group_default_map(runner):
+    """Defaults are resolved through nested groups by name at each level."""
+
+    @click.group(
+        context_settings={"default_map": {"outer": {"inner": {"opt": "deep"}}}}
+    )
+    def cli():
+        pass
+
+    @cli.group("outer")
+    def outer():
+        pass
+
+    @outer.command("inner")
+    @click.option("--opt", default="from-param")
+    def inner(opt):
+        click.echo(f"opt={opt}")
+
+    result = runner.invoke(cli, ["outer", "inner"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "opt=deep"
