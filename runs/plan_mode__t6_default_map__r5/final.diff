diff --git a/tests/test_defaults.py b/tests/test_defaults.py
index bb2684c..98d961f 100644
--- a/tests/test_defaults.py
+++ b/tests/test_defaults.py
@@ -556,3 +556,40 @@ def test_unset_in_default_map(runner):
     result = runner.invoke(cli, [])
     assert result.exit_code == 0
     assert result.output.strip() == "port=8000"
+
+
+def test_default_map_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=1)
+    def sub(port):
+        click.echo(port)
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"port": 5000}})
+    assert result.output == "5000\n"
+    # Missing subcommand key falls back to the parameter default.
+    result = runner.invoke(cli, ["sub"], default_map={"other": {"port": 5000}})
+    assert result.output == "1\n"
+
+
+def test_default_map_nested_groups(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def grp():
+        pass
+
+    @grp.command()
+    @click.option("--port", default=1)
+    def sub(port):
+        click.echo(port)
+
+    result = runner.invoke(
+        cli, ["grp", "sub"], default_map={"grp": {"sub": {"port": 7}}}
+    )
+    assert result.output == "7\n"
