         return "UUID"
 
 
+class KeyValue(ParamType[tuple[str, str]]):
+    """A parameter that accepts a ``key=value`` string and returns a
+    ``(key, value)`` tuple. The value may be empty, but the key must not be.
+    Split on the first ``=``, so the value may itself contain ``=``.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "key=value"
+
+    def convert(
+        self, value: tuple[str, str] | str, param: Parameter | None, ctx: Context | None
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple):
+            return value
+
+        key, sep, val = value.partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KeyValue"
+
