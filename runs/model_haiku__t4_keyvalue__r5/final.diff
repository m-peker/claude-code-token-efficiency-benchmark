diff --git a/tests/test_basic.py b/tests/test_basic.py
index 3ab9654..7bd27d9 100644
--- a/tests/test_basic.py
+++ b/tests/test_basic.py
@@ -264,6 +264,37 @@ def test_uuid_option(runner, args, expect):
         assert result.exception is None
 
 
+@pytest.mark.parametrize(
+    ("args", "expect"),
+    [
+        (["--set", "a=1"], "('a', '1')"),
+        (["--set", "a="], "('a', '')"),
+        (["--set", "a=b=c"], "('a', 'b=c')"),
+        (["--set", "=1"], "is not a valid key=value pair"),
+        (["--set", "abc"], "is not a valid key=value pair"),
+        (["--set", ""], "is not a valid key=value pair"),
+    ],
+)
+def test_key_value_option(runner, args, expect):
+    @click.command()
+    @click.option("--set", type=click.KeyValue())
+    def cli(set):
+        click.echo(repr(set))
+
+    result = runner.invoke(cli, args)
+
+    if "is not a valid key=value pair" in expect:
+        assert result.exit_code == 2
+        assert expect in result.output
+    else:
+        assert result.exception is None
+        assert expect in result.output
+
+
+def test_key_value_convert_passes_tuple_through():
+    assert click.KeyValue().convert(("a", "1"), None, None) == ("a", "1")
+
+
