+def test_default_map_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="default")
+    def sub(name):
+        click.echo(name)
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"name": "mapped"}})
+    assert result.output == "mapped\n"
