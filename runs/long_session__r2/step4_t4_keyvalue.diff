+class KeyValue(ParamType[tuple[str, str]]):
+    """Parses a ``key=value`` string into a ``(key, value)`` tuple. The
+    string is split on the first ``=``, so the value may itself contain
+    ``=``. The key must not be empty; the value may be.
+    """
+
+    name = "key=value"
+
+    def convert(
+        self,
+        value: tuple[str, str] | str,
+        param: Parameter | None,
+        ctx: Context | None,
+    ) -> tuple[str, str]:
+        if not isinstance(value, str):
+            return (value[0], value[1])
+
+        key, sep, val = value.partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KEY_VALUE"
+
+
