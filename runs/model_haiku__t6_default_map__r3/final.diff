+
+
+def test_default_map_subcommand_scoped_to_name(runner):
+    """A subcommand should receive only its own sub-dict of the parent's
+    ``default_map``, keyed by its name, not the whole mapping.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def serve(port):
+        click.echo(f"port={port}")
+
+    result = runner.invoke(cli, ["serve"], default_map={"serve": {"port": 9000}})
+    assert result.exit_code == 0
+    assert result.output.strip() == "port=9000"
