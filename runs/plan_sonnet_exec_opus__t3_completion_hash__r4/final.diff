@@ -391,6 +391,31 @@ def test_full_complete(runner, shell, env, expect):
     assert result.output == expect
 
 
+@pytest.mark.parametrize(
+    ("shell", "env", "expect"),
+    [
+        ("bash", {"COMP_WORDS": "cli x#y b", "COMP_CWORD": "2"}, "plain,b\n"),
+        ("zsh", {"COMP_WORDS": "cli x#y b", "COMP_CWORD": "2"}, "plain\nb\nbee\n"),
+        ("fish", {"COMP_WORDS": "cli x#y b", "COMP_CWORD": "b"}, "plain,b\tbee\n"),
+        ("fish", {"COMP_WORDS": "cli #", "COMP_CWORD": "#"}, "\n"),
+        (
+            "powershell",
+            {"COMP_WORDS": "cli x#y b", "COMP_CWORD": "2"},
+            "plain\nb\nbee\n",
+        ),
+    ],
+)
+@pytest.mark.usefixtures("_patch_for_completion")
+def test_full_complete_with_hash(runner, shell, env, expect):
+    """A "#" in the command line is not treated as a comment."""
+    sub = Group("x#y", commands=[Command("a"), Command("b", help="bee")])
+    cli = Group("cli", commands=[sub])
+    env["_CLI_COMPLETE"] = f"{shell}_complete"
+    result = runner.invoke(cli, env=env)
+    assert result.exception is None
+    assert result.output == expect
+
+
