@@ -622,6 +622,9 @@ def split_arg_string(string: str) -> list[str]:
 
     lex = shlex.shlex(string, posix=True)
     lex.whitespace_split = True
+    # Don't treat "#" as the start of a comment, it's a valid character
+    # in an argument.
+    lex.commenters = ""
     out: list[str] = []
 
     try:
