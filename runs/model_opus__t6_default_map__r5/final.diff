+
+
+def test_default_map_subcommand(runner):
+    """Subcommands get the nested ``default_map`` entry under their name."""
+
+    @click.group()
+    @click.option("--x", default="group-default")
+    def cli(x):
+        click.echo(f"group={x}")
+
+    @cli.command()
+    @click.option("--x", default="sub-default")
+    def sub(x):
+        click.echo(f"sub={x}")
+
+    result = runner.invoke(
+        cli, ["sub"], default_map={"x": "group-map", "sub": {"x": "sub-map"}}
+    )
+    assert not result.exception
+    assert result.output == "group=group-map\nsub=sub-map\n"
+
+    result = runner.invoke(cli, ["sub"], default_map={"x": "group-map"})
+    assert not result.exception
+    assert result.output == "group=group-map\nsub=sub-default\n"
