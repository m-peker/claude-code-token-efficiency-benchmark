diff --git a/tests/test_types.py b/tests/test_types.py
index 842c426..e5651f9 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -328,3 +328,40 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("a=b", ("a", "b")),
+        ("a=b=c", ("a", "b=c")),
+        ("a=", ("a", "")),
+    ],
+)
+def test_key_value(value, expect):
+    assert click.KeyValue()(value) == expect
+
+
+def test_key_value_passes_tuple_through():
+    assert click.KeyValue()(("a", "b")) == ("a", "b")
+
+
+@pytest.mark.parametrize("value", ["abc", "=b", ""])
+def test_key_value_fail(value):
+    with pytest.raises(click.BadParameter, match="is not a valid key=value pair"):
+        click.KeyValue()(value)
+
+
+def test_key_value_option(runner):
+    @click.command()
+    @click.option("--set", "pairs", type=click.KeyValue(), multiple=True)
+    def cli(pairs):
+        click.echo(repr(pairs))
+
+    result = runner.invoke(cli, ["--set", "a=1", "--set", "b=x=y"])
+    assert result.exit_code == 0
+    assert result.output == "(('a', '1'), ('b', 'x=y'))\n"
+
+    result = runner.invoke(cli, ["--set", "abc"])
+    assert result.exit_code == 2
+    assert "is not a valid key=value pair" in result.output
