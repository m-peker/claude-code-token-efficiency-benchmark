     result = runner.invoke(cli, [])
     assert result.exit_code == 0
     assert result.output.strip() == "port=8000"
+
+
+def test_subcommand_default_map_is_nested_by_name(runner):
+    """Subcommand defaults are looked up under the subcommand's name, not
+    from the top-level ``default_map`` keys.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000, type=int)
+    def runserver(port):
+        click.echo(f"port={port}")
+
+    default_map = {"runserver": {"port": 5000}, "port": 1}
+
+    result = runner.invoke(cli, ["runserver"], default_map=default_map)
+    assert not result.exception
+    assert "port=5000" in result.output
+
+    result = runner.invoke(cli, ["runserver", "--port", "6000"], default_map=default_map)
+    assert "port=6000" in result.output
+
+    result = runner.invoke(cli, ["runserver"], default_map={"other": {"port": 1}})
+    assert "port=8000" in result.output
