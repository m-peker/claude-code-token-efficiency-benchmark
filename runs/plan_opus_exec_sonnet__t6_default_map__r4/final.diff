+
+
+def test_default_map_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="default")
+    def sub(name):
+        click.echo(name)
+
+    @cli.group()
+    def grp():
+        pass
+
+    @grp.command()
+    @click.option("--x", default="d")
+    def leaf(x):
+        click.echo(x)
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"name": "from-map"}})
+    assert not result.exception
+    assert result.output == "from-map\n"
+
+    result = runner.invoke(
+        cli, ["grp", "leaf"], default_map={"grp": {"leaf": {"x": "deep"}}}
+    )
+    assert not result.exception
+    assert result.output == "deep\n"
