+
+
+def test_nested_default_map_reaches_subcommands(runner):
+    """Each subcommand and nested group reads its own sub-dict of default_map."""
+    default_map = {"sub": {"port": 5000}, "grp": {"inner": {"x": 1}}}
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=80)
+    def sub(port):
+        click.echo(f"sub {port}")
+
+    @cli.group()
+    def grp():
+        pass
+
+    @grp.command()
+    @click.option("--x", default=0)
+    @click.pass_context
+    def inner(ctx, x):
+        click.echo(f"inner {x} {ctx.get_parameter_source('x').name}")
+
+    result = runner.invoke(cli, ["sub"], default_map=default_map)
+    assert result.output == "sub 5000\n"
+
+    result = runner.invoke(cli, ["sub", "--port", "7"], default_map=default_map)
+    assert result.output == "sub 7\n"
+
+    result = runner.invoke(cli, ["grp", "inner"], default_map=default_map)
+    assert result.output == "inner 1 DEFAULT_MAP\n"
