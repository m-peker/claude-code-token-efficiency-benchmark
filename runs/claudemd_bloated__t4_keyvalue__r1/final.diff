diff --git a/tests/test_types.py b/tests/test_types.py
index 842c426..712fec0 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -328,3 +328,27 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+def test_key_value_type(runner):
+    @click.command()
+    @click.option("--set", "pair", type=click.KeyValue())
+    def cli(pair):
+        click.echo(repr(pair))
+
+    result = runner.invoke(cli, ["--set", "a=b=c"])
+    assert result.output.strip() == "('a', 'b=c')"
+    result = runner.invoke(cli, ["--set", "a="])
+    assert result.output.strip() == "('a', '')"
+
+
+@pytest.mark.parametrize("value", ["novalue", "=value", ""])
+def test_key_value_type_invalid(runner, value):
+    @click.command()
+    @click.option("--set", "pair", type=click.KeyValue())
+    def cli(pair):
+        pass
+
+    result = runner.invoke(cli, ["--set", value])
+    assert result.exit_code == 2
+    assert "is not a valid key=value pair" in result.output
