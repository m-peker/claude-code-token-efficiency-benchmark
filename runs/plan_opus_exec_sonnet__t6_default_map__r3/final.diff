+
+
+def test_default_map_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--opt", default="orig")
+    def sub(opt):
+        click.echo(opt)
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"opt": "x"}})
+    assert result.output == "x\n"
+
+    # Parent-level keys do not leak into the subcommand.
+    result = runner.invoke(cli, ["sub"], default_map={"opt": "z"})
+    assert result.output == "orig\n"
+
+
+def test_default_map_nested_groups(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def grp():
+        pass
+
+    @grp.command()
+    @click.option("--opt", default="orig")
+    def cmd(opt):
+        click.echo(opt)
+
+    result = runner.invoke(
+        cli, ["grp", "cmd"], default_map={"grp": {"cmd": {"opt": "y"}}}
+    )
+    assert result.output == "y\n"
+
+
+def test_default_map_subcommand_context_settings_wins(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command(context_settings={"default_map": {"opt": "own"}})
+    @click.option("--opt", default="orig")
+    def sub(opt):
+        click.echo(opt)
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"opt": "x"}})
+    assert result.output == "own\n"
