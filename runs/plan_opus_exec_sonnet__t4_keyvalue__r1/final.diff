diff --git a/tests/test_types.py b/tests/test_types.py
index 842c426..cd87c44 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -328,3 +328,45 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [("a=b", ("a", "b")), ("a=b=c", ("a", "b=c")), ("a=", ("a", ""))],
+)
+def test_key_value(runner, value, expect):
+    @click.command()
+    @click.option("--set", "pair", type=click.KeyValue())
+    def cli(pair):
+        click.echo(repr(pair))
+
+    result = runner.invoke(cli, ["--set", value])
+    assert result.exit_code == 0
+    assert result.output.strip() == repr(expect)
+
+
+def test_key_value_multiple(runner):
+    @click.command()
+    @click.option("--set", "pairs", type=click.KeyValue(), multiple=True)
+    def cli(pairs):
+        click.echo(repr(dict(pairs)))
+
+    result = runner.invoke(cli, ["--set", "a=1", "--set", "b=2"])
+    assert result.exit_code == 0
+    assert result.output.strip() == repr({"a": "1", "b": "2"})
+
+
+@pytest.mark.parametrize("value", ["abc", "=value", ""])
+def test_key_value_fail(runner, value):
+    @click.command()
+    @click.option("--set", type=click.KeyValue())
+    def cli(set):
+        pass
+
+    result = runner.invoke(cli, ["--set", value])
+    assert result.exit_code == 2
+    assert "is not a valid key=value pair" in result.output
+
+
+def test_key_value_already_converted():
+    assert click.KeyValue().convert(("k", "v"), None, None) == ("k", "v")
