+class KeyValue(ParamType[tuple[str, str]]):
+    """Parse a ``key=value`` string into a ``(key, value)`` tuple. The
+    value is split at the first ``=``, so the value may contain ``=``.
+    The key must not be empty; the value may be empty.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "key=value"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple) and len(value) == 2:
+            return value  # already converted, e.g. a default
+
+        value = STRING.convert(value, param, ctx)
+        key, sep, val = value.partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KeyValue()"
+
