+
+
+def test_default_map_subcommand(runner):
+    """``default_map`` entries nested under a subcommand name apply to that
+    subcommand, including through nested groups and ``context_settings``.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=1)
+    def sub(port):
+        click.echo(f"port={port}")
+
+    @cli.group()
+    def grp():
+        pass
+
+    @grp.command()
+    @click.option("--port", default=1)
+    def leaf(port):
+        click.echo(f"port={port}")
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"port": 5}})
+    assert result.output.strip() == "port=5"
+
+    result = runner.invoke(cli, ["sub"], default_map={"other": {"port": 5}})
+    assert result.output.strip() == "port=1"
+
+    result = runner.invoke(cli, ["sub"], default_map={"port": 5})
+    assert result.output.strip() == "port=1"
+
+    result = runner.invoke(
+        cli, ["grp", "leaf"], default_map={"grp": {"leaf": {"port": 7}}}
+    )
+    assert result.output.strip() == "port=7"
+
+    cli.context_settings = {"default_map": {"sub": {"port": 9}}}
+    result = runner.invoke(cli, ["sub"])
+    assert result.output.strip() == "port=9"
