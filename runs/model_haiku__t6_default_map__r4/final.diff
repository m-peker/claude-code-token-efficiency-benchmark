+
+
+def test_default_map_nested_for_subcommand(runner):
+    """A subcommand only receives its own nested ``default_map`` entry,
+    not the parent's whole mapping.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=1)
+    def runserver(port):
+        click.echo(port)
+
+    result = runner.invoke(
+        cli,
+        ["runserver"],
+        default_map={"debug": True, "runserver": {"port": 5000}},
+    )
+    assert result.exit_code == 0
+    assert result.output == "5000\n"
+
+    result = runner.invoke(cli, ["runserver"], default_map={"other": {"port": 5000}})
+    assert result.exit_code == 0
+    assert result.output == "1\n"
