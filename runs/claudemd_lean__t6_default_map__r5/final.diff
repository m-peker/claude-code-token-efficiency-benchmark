+def test_default_map_subcommand(runner):
+    """default_map entries keyed by subcommand name apply to that subcommand."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="builtin")
+    def foo(name):
+        click.echo(name)
+
+    result = runner.invoke(cli, ["foo"], default_map={"foo": {"name": "mapped"}})
+    assert result.output.strip() == "mapped"
+
+    result = runner.invoke(cli, ["foo"], default_map={"name": "wrong"})
+    assert result.output.strip() == "builtin"
+
 
