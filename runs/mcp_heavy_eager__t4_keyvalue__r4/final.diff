+class KeyValue(ParamType[t.Tuple[str, str]]):
+    """Parses a ``key=value`` string into a ``(key, value)`` tuple. The
+    string is split on the first ``=``, so the value may itself contain
+    ``=``. The key must not be empty; the value may be.
+
+    .. versionadded:: 8.3
+    """
+
+    name = "key_value"
+
+    def convert(
+        self,
+        value: t.Any,
+        param: Parameter | None,
+        ctx: Context | None,
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple):
+            return value  # type: ignore[no-any-return]
+
+        key, sep, val = str(value).partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KeyValue"
+
