+
+
+def test_default_map_subcommands(runner):
+    """Subcommands use the nested ``default_map`` entry for their name."""
+
+    @click.group()
+    @click.option("--name", default="root-default")
+    def cli(name):
+        click.echo(f"cli={name}")
+
+    @cli.command()
+    @click.option("--name", default="sub-default")
+    def sub(name):
+        click.echo(f"sub={name}")
+
+    @cli.group()
+    def inner():
+        pass
+
+    @inner.command()
+    @click.option("--name", default="leaf-default")
+    def leaf(name):
+        click.echo(f"leaf={name}")
+
+    default_map = {
+        "name": "root-map",
+        "sub": {"name": "sub-map"},
+        "inner": {"leaf": {"name": "leaf-map"}},
+    }
+
+    result = runner.invoke(cli, ["sub"], default_map=default_map)
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines() == ["cli=root-map", "sub=sub-map"]
+
+    result = runner.invoke(cli, ["inner", "leaf"], default_map=default_map)
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines() == ["cli=root-map", "leaf=leaf-map"]
+
+    # A subcommand without an entry falls back to its parameter default.
+    result = runner.invoke(cli, ["sub"], default_map={"name": "root-map"})
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines() == ["cli=root-map", "sub=sub-default"]
