+
+
+def test_subcommand_default_map(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="normal")
+    def sub(name):
+        click.echo(name)
+
+    result = runner.invoke(
+        cli, ["sub"], default_map={"sub": {"name": "changed"}}
+    )
+    assert not result.exception
+    assert result.output == "changed\n"
