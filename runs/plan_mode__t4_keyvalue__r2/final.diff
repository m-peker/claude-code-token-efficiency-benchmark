+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("a=b", ("a", "b")),
+        ("a=b=c", ("a", "b=c")),
+        ("a=", ("a", "")),
+        (("a", "b"), ("a", "b")),
+    ],
+)
+def test_key_value(value, expect):
+    assert click.KeyValue().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize("value", ["abc", "", "=v", "="])
+def test_key_value_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.KeyValue().convert(value, None, None)
+
+    assert "is not a valid key=value pair" in exc_info.value.message
+
+
+def test_key_value_option(runner):
+    @click.command()
+    @click.option("--set", "pairs", type=click.KeyValue(), multiple=True)
+    def cli(pairs):
+        click.echo(repr(pairs))
+
+    result = runner.invoke(cli, ["--set", "a=1", "--set", "b=2=3"])
+    assert not result.exception
+    assert result.output == "(('a', '1'), ('b', '2=3'))\n"
+
+    result = runner.invoke(cli, ["--set", "ab"])
+    assert result.exit_code == 2
+    assert "'ab' is not a valid key=value pair" in result.output
+
