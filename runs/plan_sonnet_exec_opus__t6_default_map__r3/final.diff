+def test_default_map_subcommands(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def nested():
+        pass
+
+    @cli.command()
+    @click.option("--port", type=int)
+    def sub(port):
+        click.echo(f"sub={port}")
+
+    @nested.command()
+    @click.option("--port", type=int)
+    def deep(port):
+        click.echo(f"deep={port}")
+
+    default_map = {"sub": {"port": 5000}, "nested": {"deep": {"port": 6000}}}
+    result = runner.invoke(cli, ["sub"], default_map=default_map)
+    assert result.output == "sub=5000\n"
+    result = runner.invoke(cli, ["nested", "deep"], default_map=default_map)
+    assert result.output == "deep=6000\n"
