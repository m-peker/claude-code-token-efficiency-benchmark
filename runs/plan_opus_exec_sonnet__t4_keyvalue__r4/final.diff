@@ -264,6 +264,32 @@ def test_uuid_option(runner, args, expect):
         assert result.exception is None
 
 
+@pytest.mark.parametrize(
+    ("args", "expect"),
+    [
+        (["--set", "a=b"], "KV:[('a', 'b')]"),
+        (["--set", "a="], "KV:[('a', '')]"),
+        (["--set", "a=b=c"], "KV:[('a', 'b=c')]"),
+        (["--set", "a=b", "--set", "c=d"], "KV:[('a', 'b'), ('c', 'd')]"),
+        (["--set", "ab"], "'ab' is not a valid key=value pair."),
+        (["--set", "=b"], "'=b' is not a valid key=value pair."),
+    ],
+)
+def test_key_value_option(runner, args, expect):
+    @click.command()
+    @click.option("--set", "pairs", type=click.KeyValue(), multiple=True)
+    def cli(pairs):
+        click.echo(f"KV:[{', '.join(map(str, pairs))}]")
+
+    result = runner.invoke(cli, args)
+    assert expect in result.output
+
+    if "not a valid" in expect:
+        assert result.exception is not None
+    else:
+        assert result.exception is None
+
