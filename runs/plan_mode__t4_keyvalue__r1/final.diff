--- a/tests/test_basic.py
+++ b/tests/test_basic.py
@@ -264,6 +264,34 @@ def test_uuid_option(runner, args, expect):
         assert result.exception is None
 
 
+@pytest.mark.parametrize(
+    ("args", "expect"),
+    [
+        ([], "S:[()]"),
+        (["--set=a=b"], "S:[(('a', 'b'),)]"),
+        (["--set=a=b=c"], "S:[(('a', 'b=c'),)]"),
+        (["--set=a="], "S:[(('a', ''),)]"),
+        (["--set=a=1", "--set=b=2"], "S:[(('a', '1'), ('b', '2'))]"),
+        (["--set=novalue"], "'novalue' is not a valid key=value pair"),
+        (["--set==value"], "'=value' is not a valid key=value pair"),
+        (["--set="], "'' is not a valid key=value pair"),
+    ],
+)
+def test_key_value_option(runner, args, expect):
+    @click.command()
+    @click.option("--set", "pairs", type=click.KeyValue(), multiple=True)
+    def cli(pairs):
+        click.echo(f"S:[{pairs}]")
+
+    result = runner.invoke(cli, args)
+    assert expect in result.output
+
+    if "is not a valid" in expect:
+        assert result.exit_code == 2
+    else:
+        assert result.exception is None
+
+
