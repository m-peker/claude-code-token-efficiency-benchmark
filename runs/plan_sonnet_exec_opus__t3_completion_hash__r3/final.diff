diff --git a/tests/test_shell_completion.py b/tests/test_shell_completion.py
index 10d5cfa..8c5cf7d 100644
--- a/tests/test_shell_completion.py
+++ b/tests/test_shell_completion.py
@@ -391,6 +391,33 @@ def test_full_complete(runner, shell, env, expect):
     assert result.output == expect
 
 
+@pytest.mark.parametrize(
+    ("shell", "env", "expect"),
+    [
+        ("bash", {"COMP_WORDS": "cli -t #a #", "COMP_CWORD": "3"}, "plain,#b\n"),
+        ("zsh", {"COMP_WORDS": "cli -t #a #", "COMP_CWORD": "3"}, "plain\n#b\n_\n"),
+        ("fish", {"COMP_WORDS": "cli -t #a #", "COMP_CWORD": "#"}, "plain,#b\n"),
+        (
+            "powershell",
+            {"COMP_WORDS": "cli -t #a #", "COMP_CWORD": "3"},
+            "plain\n#b\n_\n",
+        ),
+    ],
+)
+@pytest.mark.usefixtures("_patch_for_completion")
+def test_full_complete_hash(runner, shell, env, expect):
+    cli = Command(
+        "cli",
+        params=[
+            Option(["-t"], type=Choice(["#a", "x"])),
+            Argument(["v"], type=Choice(["#b", "y"])),
+        ],
+    )
+    env["_CLI_COMPLETE"] = f"{shell}_complete"
+    result = runner.invoke(cli, env=env)
+    assert result.output == expect
+
+
