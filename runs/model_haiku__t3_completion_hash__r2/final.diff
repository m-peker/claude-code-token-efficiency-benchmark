+
+
+@pytest.mark.parametrize(
+    ("string", "expect"),
+    [
+        ("cmd a#b c", ["cmd", "a#b", "c"]),
+        ("cmd #x y", ["cmd", "#x", "y"]),
+        ("cmd a #", ["cmd", "a", "#"]),
+        ("cmd 'a#b' \"#c\"", ["cmd", "a#b", "#c"]),
+    ],
+)
+def test_split_arg_string_hash(string: str, expect: list[str]) -> None:
+    # "#" is not a comment in shell words, so nothing after it is dropped.
+    assert split_arg_string(string) == expect
