+
+
+def test_default_map_nested_subcommands(runner):
+    """``default_map`` entries are looked up by subcommand name, per level."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="x")
+    def sub(name):
+        click.echo(name)
+
+    @cli.group()
+    def a():
+        pass
+
+    @a.command()
+    @click.option("--name", default="x")
+    def b(name):
+        click.echo(name)
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"name": "from-map"}})
+    assert result.output == "from-map\n"
+
+    result = runner.invoke(
+        cli, ["a", "b"], default_map={"a": {"b": {"name": "nested"}}}
+    )
+    assert result.output == "nested\n"
+
+    # A top-level key must not leak into the subcommand.
+    result = runner.invoke(cli, ["sub"], default_map={"name": "leak"})
+    assert result.output == "x\n"
