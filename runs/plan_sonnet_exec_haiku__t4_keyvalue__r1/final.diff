@@ -896,6 +896,37 @@ class UUIDParameterType(ParamType[uuid.UUID]):
         return "UUID"
 
 
+class KeyValue(ParamType[tuple[str, str]]):
+    """Declares a parameter to be a ``key=value`` pair. The value is split on
+    the first ``=``, so ``a=b=c`` becomes ``("a", "b=c")``. An empty value
+    (``a=``) is allowed, but a missing ``=`` or an empty key is an error.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "key_value"
+
+    def convert(
+        self, value: tuple[str, str] | str, param: Parameter | None, ctx: Context | None
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple):
+            return value
+
+        key, sep, val = value.partition("=")
+
+        if not sep or not key.strip():
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KeyValue"
+
+
 class FileInfoDict(ParamTypeInfoDict):
