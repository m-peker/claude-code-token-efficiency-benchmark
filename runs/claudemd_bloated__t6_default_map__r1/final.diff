+
+
+def test_default_map_nested_for_subcommand(runner):
+    """``default_map`` entries keyed by subcommand name apply to that
+    subcommand, and missing entries fall back to the parameter default."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def serve(port):
+        click.echo(f"port={port}")
+
+    @cli.command()
+    @click.option("--port", default=1)
+    def other(port):
+        click.echo(f"port={port}")
+
+    default_map = {"serve": {"port": 9000}}
+    result = runner.invoke(cli, ["serve"], default_map=default_map)
+    assert result.output.strip() == "port=9000"
+    result = runner.invoke(cli, ["other"], default_map=default_map)
+    assert result.output.strip() == "port=1"
