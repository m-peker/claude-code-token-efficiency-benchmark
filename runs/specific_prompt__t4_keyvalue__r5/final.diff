diff --git a/tests/test_types.py b/tests/test_types.py
index 842c426..996651e 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -328,3 +328,38 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("a=b", ("a", "b")),
+        ("a=b=c", ("a", "b=c")),
+        ("a=", ("a", "")),
+        (("a", "b"), ("a", "b")),
+    ],
+)
+def test_key_value(value, expect):
+    assert click.KeyValue()(value) == expect
+
+
+@pytest.mark.parametrize("value", ["abc", "=value", ""])
+def test_key_value_fail(runner, value):
+    @click.command()
+    @click.option("--set", "set_", type=click.KeyValue())
+    def cli(set_):
+        pass
+
+    result = runner.invoke(cli, ["--set", value])
+    assert result.exit_code == 2
+    assert "is not a valid key=value pair" in result.output
+
+
+def test_key_value_option(runner):
+    @click.command()
+    @click.option("--set", "set_", type=click.KeyValue(), multiple=True)
+    def cli(set_):
+        click.echo(repr(set_))
+
+    result = runner.invoke(cli, ["--set", "a=1", "--set", "b=x=y"])
+    assert result.output.strip() == "(('a', '1'), ('b', 'x=y'))"
