@@ -1,3 +1,12 @@
+## Version 8.5.1
+
+Unreleased
+
+- Shell completion keeps `#` in the words it splits. Previously everything
+  after a `#` was dropped as a shell comment, so completion gave wrong
+  results, and a Fish incomplete word starting with `#` raised an
+  `IndexError`.
+
 ## Version 8.5.0
 
 Released 2026-08-24
diff --git a/src/click/shell_completion.py b/src/click/shell_completion.py
index 42e8885..6070a7f 100644
--- a/src/click/shell_completion.py
+++ b/src/click/shell_completion.py
@@ -617,11 +617,18 @@ def split_arg_string(string: str) -> list[str]:
 
     .. versionchanged:: 8.2
         Moved to ``shell_completion`` from ``parser``.
+
+    .. versionchanged:: 8.5.1
+        ``#`` is not treated as a comment start, so it is kept in the
+        split arguments.
     """
     import shlex
 
     lex = shlex.shlex(string, posix=True)
     lex.whitespace_split = True
+    # The string is a partial command line, not shell source, so "#" is
+    # an ordinary character and must not start a comment.
+    lex.commenters = ""
     out: list[str] = []
 
     try:
