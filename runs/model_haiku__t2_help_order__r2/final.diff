+
+
+def test_option_help_lists_short_flag_before_long():
+    """Option names are shown shortest prefix first, e.g. ``-v, --verbose``."""
+    cli = click.Command(
+        "cli",
+        params=[click.Option(["-v", "--verbose"], is_flag=True, help="Verbose.")],
+    )
+    help_text = cli.get_help(click.Context(cli))
+    assert "-v, --verbose" in help_text
+    assert "--verbose, -v" not in help_text
