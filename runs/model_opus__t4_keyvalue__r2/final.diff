         return "UUID"
 
 
+class KeyValue(ParamType[tuple[str, str]]):
+    """Parses a ``key=value`` string into a ``(key, value)`` tuple.
+
+    The string is split on the first ``=``, so the value may itself
+    contain ``=``. The key must not be empty, but the value may be.
+
+    .. code-block:: python
+
+        @click.option("--set", "settings", type=click.KeyValue(), multiple=True)
+
+    .. versionadded:: 8.6
+    """
+
+    name = "key_value"
+
+    def get_metavar(self, param: Parameter, ctx: Context) -> str:
+        return "KEY=VALUE"
+
+    def convert(
+        self,
+        value: tuple[str, str] | str,
+        param: Parameter | None,
+        ctx: Context | None,
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple):
+            return value
+
+        key, sep, val = value.partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KeyValue"
+
