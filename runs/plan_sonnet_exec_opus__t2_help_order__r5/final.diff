+
+
+@pytest.mark.parametrize(
+    ("options", "expected"),
+    [
+        (["--help", "-h"], "-h, --help"),
+        (["-v", "--verbose"], "-v, --verbose"),
+        (["--verbose", "-v", "--loud"], "-v, --verbose, --loud"),
+    ],
+)
+def test_join_options_short_first(options, expected):
+    from click.formatting import join_options
+
+    assert join_options(options) == (expected, False)
+
+
+def test_help_option_names_short_first(runner):
+    @click.command()
+    @click.option("--verbose", "-v", is_flag=True)
+    def cli(verbose):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert "-v, --verbose" in result.output
