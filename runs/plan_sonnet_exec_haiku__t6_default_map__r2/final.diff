+def test_default_map_applies_to_subcommand(runner):
+    """A ``default_map`` keyed by subcommand name supplies that subcommand's
+    defaults, not the parent's.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--opt", default=0)
+    @click.pass_context
+    def sub(ctx, opt):
+        click.echo(f"opt={opt} source={ctx.get_parameter_source('opt').name}")
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"opt": 1}})
+    assert not result.exception
+    assert "opt=1 source=DEFAULT_MAP" in result.output
+
+
+def test_default_map_nested_subcommands(runner):
+    """Nested ``default_map`` entries are narrowed at each level."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def outer():
+        pass
+
+    @outer.command()
+    @click.option("--opt", default=0)
+    def inner(opt):
+        click.echo(f"opt={opt}")
+
+    result = runner.invoke(
+        cli, ["outer", "inner"], default_map={"outer": {"inner": {"opt": 2}}}
+    )
+    assert not result.exception
+    assert "opt=2" in result.output
+
+
+def test_default_map_subcommand_option_named_like_subcommand(runner):
+    """A subcommand option named after the subcommand does not receive the
+    subcommand's whole default dict.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--sub", default="original")
+    def sub(sub):
+        click.echo(f"sub={sub!r}")
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"opt": 1}})
+    assert not result.exception
+    assert "sub='original'" in result.output
+
+
+def test_default_map_missing_subcommand_key(runner):
+    """A subcommand with no ``default_map`` entry uses its parameter defaults."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--opt", default=0)
+    @click.pass_context
+    def sub(ctx, opt):
+        click.echo(f"opt={opt} source={ctx.get_parameter_source('opt').name}")
+
+    result = runner.invoke(cli, ["sub"], default_map={"other": {"opt": 1}})
+    assert not result.exception
+    assert "opt=0 source=DEFAULT" in result.output
+
+
+def test_default_map_unset_subcommand_value(runner):
+    """An ``UNSET`` sub-dict is treated as no defaults for that subcommand."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--opt", default=0)
+    @click.pass_context
+    def sub(ctx, opt):
+        click.echo(f"opt={opt} source={ctx.get_parameter_source('opt').name}")
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": UNSET})
+    assert not result.exception
+    assert "opt=0 source=DEFAULT" in result.output
+
