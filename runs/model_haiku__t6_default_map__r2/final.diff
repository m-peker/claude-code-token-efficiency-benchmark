+
+
+def test_default_map_nested_for_subcommand(runner):
+    """Each subcommand reads its own nested ``default_map`` entry, not the
+    parent's whole mapping.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def runserver(port):
+        click.echo(f"port={port}")
+
+    @cli.command()
+    @click.option("--port", default=9000)
+    def other(port):
+        click.echo(f"port={port}")
+
+    default_map = {"runserver": {"port": 5000}}
+    result = runner.invoke(cli, ["runserver"], default_map=default_map)
+    assert result.exit_code == 0
+    assert result.output.strip() == "port=5000"
+
+    result = runner.invoke(cli, ["other"], default_map=default_map)
+    assert result.exit_code == 0
+    assert result.output.strip() == "port=9000"
