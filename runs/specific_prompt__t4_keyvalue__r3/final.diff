         return "UUID"
 
 
+class KeyValue(ParamType[t.Tuple[str, str]]):
+    """Parses ``key=value`` strings into a ``(key, value)`` tuple. The
+    string is split on the first ``=`` only.
+    """
+
+    name = "key_value"
+
+    def convert(
+        self,
+        value: tuple[str, str] | str,
+        param: Parameter | None,
+        ctx: Context | None,
+    ) -> tuple[str, str]:
+        if not isinstance(value, str):
+            return value
+
+        key, sep, val = value.partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KEY_VALUE"
+
+
