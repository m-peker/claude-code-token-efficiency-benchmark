+
+
+def test_default_map_applies_to_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=1)
+    def sub(port):
+        click.echo(f"sub={port}")
+
+    @cli.command()
+    @click.option("--port", default=1)
+    def other(port):
+        click.echo(f"other={port}")
+
+    default_map = {"sub": {"port": 5000}}
+
+    result = runner.invoke(cli, ["sub"], default_map=default_map)
+    assert result.output == "sub=5000\n"
+
+    # CLI argument wins over default_map.
+    result = runner.invoke(cli, ["sub", "--port", "7"], default_map=default_map)
+    assert result.output == "sub=7\n"
+
+    # Subcommand without an entry is unaffected.
+    result = runner.invoke(cli, ["other"], default_map=default_map)
+    assert result.output == "other=1\n"
+
+
+def test_default_map_applies_to_nested_group(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def inner():
+        pass
+
+    @inner.command()
+    @click.option("--port", default=1)
+    def sub(port):
+        click.echo(f"sub={port}")
+
+    result = runner.invoke(
+        cli, ["inner", "sub"], default_map={"inner": {"sub": {"port": 9}}}
+    )
+    assert result.output == "sub=9\n"
