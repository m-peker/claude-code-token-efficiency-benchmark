+def test_short_options_listed_before_long(runner):
+    @click.command()
+    @click.option("--verbose", "-v", is_flag=True, help="Be verbose.")
+    @click.option("-n", "--name", help="A name.")
+    def cli(verbose, name):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
