+
+
+def test_default_map_subcommand(runner):
+    """A subcommand's options read defaults from ``default_map[subcommand]``,
+    not from the top-level ``default_map`` itself.
+    """
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="original")
+    def sub(name):
+        click.echo(f"name={name}")
+
+    result = runner.invoke(cli, ["sub"], default_map={"sub": {"name": "mapped"}})
+    assert not result.exception
+    assert "name=mapped" in result.output
+
+    # Entry for another subcommand does not apply.
+    result = runner.invoke(cli, ["sub"], default_map={"other": {"name": "mapped"}})
+    assert not result.exception
+    assert "name=original" in result.output
+
+
+def test_default_map_nested_subcommand(runner):
+    """``default_map`` is resolved one level at a time for nested groups."""
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def group():
+        pass
+
+    @group.command()
+    @click.option("--name", default="original")
+    def sub(name):
+        click.echo(f"name={name}")
+
+    default_map = {"group": {"sub": {"name": "mapped"}}}
+    result = runner.invoke(cli, ["group", "sub"], default_map=default_map)
+    assert not result.exception
+    assert "name=mapped" in result.output
