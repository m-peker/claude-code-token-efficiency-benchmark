@@ -1293,6 +1293,44 @@ class Tuple(CompositeParamType[tuple[t.Any, ...]]):
         )
 
 
+class KeyValue(ParamType):
+    """Parse a ``key=value`` string into a ``(key, value)`` tuple.
+
+    The string is split on the first ``=``, so the value may contain
+    ``=`` itself. The value may be empty, but the key must not be.
+
+    .. code-block:: python
+
+        @click.option("--set", type=click.KeyValue())
+        def cli(set):
+            key, value = set
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "key=value"
+
+    def convert(
+        self,
+        value: t.Any,
+        param: Parameter | None,
+        ctx: Context | None,
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple):
+            return value
+
+        key, sep, val = str(value).partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+
 def _guess_type(
