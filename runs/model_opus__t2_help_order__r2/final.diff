diff --git a/tests/test_formatting.py b/tests/test_formatting.py
index 272b075..318bb73 100644
--- a/tests/test_formatting.py
+++ b/tests/test_formatting.py
@@ -630,3 +630,26 @@ def test_command_write_usage_no_args(runner, command_kwargs, expected_usage_line
     cli = click.Command("cli", **command_kwargs)
     result = runner.invoke(cli, ["--help"])
     assert result.output.splitlines()[0] == expected_usage_line
+
+
+@pytest.mark.parametrize(
+    ("decls", "expected"),
+    [
+        (("--verbose", "-v"), "-v, --verbose"),
+        (("-v", "--verbose"), "-v, --verbose"),
+        (("--foo/--no-foo", "-f"), "-f, --foo / --no-foo"),
+        (("/debug;/no-debug",), "/debug; /no-debug"),
+    ],
+)
+def test_help_short_options_listed_first(runner, decls, expected):
+    """Option names are listed shortest prefix first, so short options
+    come before long ones regardless of declaration order.
+    """
+
+    @click.command()
+    @click.option(*decls, is_flag=True)
+    def cli(**kwargs):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert f"  {expected}" in result.output
