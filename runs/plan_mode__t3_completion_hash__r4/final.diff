     return [c.value for c in _get_completions(cli, args, incomplete)]
 
 
+@pytest.mark.parametrize(
+    ("string", "expect"),
+    [
+        ("prog a#b", ["prog", "a#b"]),
+        ("prog #x", ["prog", "#x"]),
+        ("prog 'a #b", ["prog", "a #b"]),
+    ],
+)
+def test_split_arg_string_hash(string: str, expect: list[str]) -> None:
+    assert click.shell_completion.split_arg_string(string) == expect
+
+
+def test_hash_in_complete_arg():
+    cli = Command(
+        "cli",
+        params=[Argument(["x"], type=Choice(["a#b", "a#c"])), Argument(["y"])],
+    )
+    assert _get_words(cli, ["a#b"], "") == []
+    assert _get_words(cli, [], "a#") == ["a#b", "a#c"]
+
+
 def test_command():
     cli = Command("cli", params=[Option(["-t", "--test"])])
     assert _get_words(cli, [], "") == []
