+
+
+def test_default_map_subcommands(runner):
+    """Nested ``default_map`` entries apply to subcommands, nested groups,
+    and missing entries fall back to the parameter's own default.
+    """
+
+    @click.group()
+    @click.option("--debug/--no-debug", default=False)
+    def cli(debug):
+        click.echo(f"debug={debug}")
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def runserver(port):
+        click.echo(f"port={port}")
+
+    @cli.group()
+    def db():
+        pass
+
+    @db.command()
+    @click.option("--url", default="sqlite://")
+    def migrate(url):
+        click.echo(f"url={url}")
+
+    default_map = {
+        "debug": True,
+        "runserver": {"port": 5000},
+        "db": {"migrate": {"url": "postgres://"}},
+    }
+
+    result = runner.invoke(cli, ["runserver"], default_map=default_map)
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines() == ["debug=True", "port=5000"]
+
+    result = runner.invoke(cli, ["db", "migrate"], default_map=default_map)
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines() == ["debug=True", "url=postgres://"]
+
+    result = runner.invoke(cli, ["runserver"], default_map={"debug": True})
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines() == ["debug=True", "port=8000"]
+
+    result = runner.invoke(cli, ["runserver"], default_map={"runserver": UNSET})
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines() == ["debug=False", "port=8000"]
