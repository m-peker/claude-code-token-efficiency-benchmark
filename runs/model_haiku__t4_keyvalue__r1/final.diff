@@ -1293,6 +1293,38 @@ class Tuple(CompositeParamType[tuple[t.Any, ...]]):
         )
 
 
+class KeyValue(ParamType[tuple[str, str]]):
+    """Parse a ``key=value`` string into a ``(key, value)`` tuple. The key
+    must be non-empty. The value may be empty or contain ``=``; only the
+    first ``=`` separates the two parts.
+
+    .. code-block:: python
+
+        @click.option("--set", type=click.KeyValue())
+
+    .. versionadded:: 8.6
+    """
+
+    name = "key-value"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple):
+            return value
+
+        key, sep, val = value.partition("=")
+
+        if not sep or not key:
+            self.fail(
+                f"{value!r} is not a valid key=value pair.",
+                param=param,
+                ctx=ctx,
+            )
+
+        return key, val
+
+
 def _guess_type(
     ty: type[t.Any] | ParamType[t.Any] | None,
     default: t.Any | None,
diff --git a/tests/test_types.py b/tests/test_types.py
index 842c426..f4dd8f0 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -328,3 +328,43 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("a=b", ("a", "b")),
+        ("a=", ("a", "")),
+        ("a=b=c", ("a", "b=c")),
+        (" a = b", (" a ", " b")),
+    ],
+)
+def test_key_value(value, expect):
+    assert click.KeyValue().convert(value, None, None) == expect
+
+
+def test_key_value_passes_through_tuple():
+    assert click.KeyValue().convert(("a", "b"), None, None) == ("a", "b")
+
+
+@pytest.mark.parametrize("value", ["ab", "=b", "", "="])
+def test_key_value_invalid(value):
+    with pytest.raises(click.BadParameter, match="is not a valid key=value pair"):
+        click.KeyValue().convert(value, None, None)
+
+
+def test_key_value_option():
+    @click.command()
+    @click.option("--set", "pairs", type=click.KeyValue(), multiple=True)
+    def cli(pairs):
+        for key, value in pairs:
+            click.echo(f"{key}->{value}")
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, ["--set", "a=1", "--set", "b=x=y"])
+    assert result.exit_code == 0
+    assert result.output == "a->1\nb->x=y\n"
+
+    result = runner.invoke(cli, ["--set", "oops"])
+    assert result.exit_code == 2
+    assert "is not a valid key=value pair" in result.output
