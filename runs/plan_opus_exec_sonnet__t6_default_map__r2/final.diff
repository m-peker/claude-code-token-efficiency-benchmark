@@ -556,3 +556,37 @@ def test_unset_in_default_map(runner):
     result = runner.invoke(cli, [])
     assert result.exit_code == 0
     assert result.output.strip() == "port=8000"
+
+
+def test_default_map_subcommand(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--port", default=8000)
+    def runserver(port):
+        click.echo(port)
+
+    result = runner.invoke(
+        cli, ["runserver"], default_map={"runserver": {"port": 5000}}
+    )
+    assert result.output.strip() == "5000"
+
+
+def test_default_map_nested_groups(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def a():
+        pass
+
+    @a.command()
+    @click.option("--x", default="orig")
+    def b(x):
+        click.echo(x)
+
+    result = runner.invoke(cli, ["a", "b"], default_map={"a": {"b": {"x": "mapped"}}})
+    assert result.output.strip() == "mapped"
