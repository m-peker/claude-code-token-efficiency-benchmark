diff --git a/tests/test_basic.py b/tests/test_basic.py
index 3ab9654..c7fde95 100644
--- a/tests/test_basic.py
+++ b/tests/test_basic.py
@@ -264,6 +264,47 @@ def test_uuid_option(runner, args, expect):
         assert result.exception is None
 
 
+@pytest.mark.parametrize(
+    ("args", "expect"),
+    [
+        (["--set", "a=b"], "S:[('a', 'b')]"),
+        (["--set", "a=b=c"], "S:[('a', 'b=c')]"),
+        (
+            ["--set", "ab"],
+            "Error: Invalid value for '--set': 'ab' is not a valid key=value pair.",
+        ),
+        (
+            ["--set", "=b"],
+            "Error: Invalid value for '--set': '=b' is not a valid key=value pair.",
+        ),
+    ],
+)
+def test_key_value_option(runner, args, expect):
+    @click.command()
+    @click.option("--set", "s", type=click.KeyValue())
+    def cli(s):
+        click.echo(f"S:[{s!r}]")
+
+    result = runner.invoke(cli, args)
+    assert expect in result.output
+
+    if expect.startswith("Error:"):
+        assert result.exit_code == 2
+    else:
+        assert result.exception is None
+
+
+def test_key_value_option_multiple(runner):
+    @click.command()
+    @click.option("--set", "s", type=click.KeyValue(), multiple=True)
+    def cli(s):
+        click.echo(repr(dict(s)))
+
+    result = runner.invoke(cli, ["--set", "a=1", "--set", "b=2"])
+    assert result.exception is None
+    assert result.output == "{'a': '1', 'b': '2'}\n"
+
+
 @pytest.mark.parametrize(
     ("args", "expect"),
     [
