+def test_group_default_map_subcommand_section(runner):
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--name", default="normal")
+    def foo(name):
+        click.echo(name)
+
+    result = runner.invoke(cli, ["foo"], default_map={"foo": {"name": "changed"}})
+    assert result.output == "changed\n"
+    result = runner.invoke(cli, ["foo"])
+    assert result.output == "normal\n"
+
