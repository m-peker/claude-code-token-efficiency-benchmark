+class KeyValue(ParamType[tuple[str, str]]):
+    """Parses a ``key=value`` string into a ``(key, value)`` tuple.
+
+    The string is split on the first ``=``, so the value may itself
+    contain ``=``. The key must not be empty; the value may be.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "key=value"
+
+    def get_metavar(self, param: Parameter, ctx: Context) -> str | None:
+        return "KEY=VALUE"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> tuple[str, str]:
+        if isinstance(value, tuple) and len(value) == 2:
+            return (str(value[0]), str(value[1]))
+
+        value = STRING.convert(value, param, ctx)
+        key, sep, val = value.partition("=")
+
+        if not sep or not key:
+            self.fail(
+                _("{value!r} is not a valid key=value pair.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return key, val
+
+    def __repr__(self) -> str:
+        return "KeyValue"
+
+
