diff --git a/tests/test_types.py b/tests/test_types.py
index 842c426..14d249d 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -328,3 +328,30 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [("a=b", ("a", "b")), ("a=", ("a", "")), ("a=b=c", ("a", "b=c"))],
+)
+def test_key_value_valid(runner, value, expected):
+    @click.command()
+    @click.option("--set", "pair", type=click.KeyValue())
+    def cli(pair):
+        click.echo(repr(pair))
+
+    result = runner.invoke(cli, ["--set", value])
+    assert result.exit_code == 0
+    assert result.output.strip() == repr(expected)
+
+
+@pytest.mark.parametrize("value", ["abc", "=value", ""])
+def test_key_value_invalid(runner, value):
+    @click.command()
+    @click.option("--set", "pair", type=click.KeyValue())
+    def cli(pair):
+        pass
+
+    result = runner.invoke(cli, ["--set", value])
+    assert result.exit_code == 2
+    assert "is not a valid key=value pair" in result.output
